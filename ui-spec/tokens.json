{
  "$schemaVersion": "1.0.0",
  "$name": "Tool UI Spec — Design Tokens",
  "$description": "工具型 Web / 客户端产品的通用 UI 令牌。三层结构：primitive(原始值) → semantic(语义角色) → component(组件契约)。组件层只允许引用 semantic / component，禁止直接引用 primitive。",
  "meta": {
    "version": "1.0.0",
    "updated": "2026-10-19",
    "scope": "web / desktop tool products (IDE, editor, console, admin, AI workspace)",
    "designGoal": "降低长期使用的认知负担，而非追求第一眼惊艳",
    "layers": ["primitive", "semantic", "component"],
    "brandSwappable": ["accent.*", "font.family.*", "radius.personality", "motion.personality"]
  },

  "primitive": {
    "$note": "原始调色板。组件层禁止直接使用本段任何值。默认采用暖中性灰，适合长时段注视；可整体替换为冷中性或纯中性。",
    "neutral": {
      "0":   "#ffffff",
      "10":  "#fcfcfb",
      "20":  "#f7f6f4",
      "30":  "#f2f1ee",
      "40":  "#e8e6e2",
      "50":  "#d9d7d2",
      "60":  "#b8b5af",
      "70":  "#8f8c86",
      "80":  "#6b6862",
      "90":  "#3a3835",
      "95":  "#26251f",
      "100": "#1c1b19"
    },
    "neutralDark": {
      "900": "#0d0d0c",
      "850": "#131311",
      "830": "#191917",
      "800": "#1f1f1c",
      "750": "#262622",
      "700": "#32322d",
      "600": "#4a4942"
    },
    "accent": {
      "50":  "#fdf1ec",
      "100": "#f9ddd1",
      "300": "#e5a488",
      "500": "#c96442",
      "600": "#b5573a",
      "700": "#a04c33",
      "800": "#843d29"
    },
    "status": {
      "success": { "light": "#2e8b62", "dark": "#5fbd8d" },
      "warning": { "light": "#b8801f", "dark": "#d9a34a" },
      "danger":  { "light": "#c0453c", "dark": "#e06a5f" },
      "info":    { "light": "#3a72b8", "dark": "#6f9fd8" }
    }
  },

  "semantic": {
    "$note": "语义角色。这是组件层唯一允许引用的色彩层。深色模式不是反色，而是重新映射。",
    "light": {
      "surface-0":    "#f4f3f0",
      "surface-1":    "#faf9f7",
      "surface-2":    "#ffffff",
      "surface-3":    "#ffffff",
      "surface-sunken": "#efeeea",
      "surface-hover":  "#f0efeb",
      "surface-active": "#e8e6e2",

      "text-primary":   "#1c1b19",
      "text-secondary": "#6b6862",
      "text-tertiary":  "#9a978f",
      "text-disabled":  "#b8b5af",
      "text-inverse":   "#ffffff",
      "text-on-accent": "#ffffff",

      "border-subtle":  "rgba(28, 27, 25, 0.07)",
      "border-default": "rgba(28, 27, 25, 0.11)",
      "border-strong":  "rgba(28, 27, 25, 0.19)",
      "border-focus":   "rgba(201, 100, 66, 0.55)",

      "accent":         "#c96442",
      "accent-hover":   "#b5573a",
      "accent-active":  "#a04c33",
      "accent-subtle":  "rgba(201, 100, 66, 0.10)",
      "accent-ring":    "rgba(201, 100, 66, 0.40)",

      "success": "#2e8b62",
      "warning": "#b8801f",
      "danger":  "#c0453c",
      "info":    "#3a72b8",
      "success-subtle": "rgba(46, 139, 98, 0.11)",
      "warning-subtle": "rgba(184, 128, 31, 0.12)",
      "danger-subtle":  "rgba(192, 69, 60, 0.11)",
      "info-subtle":    "rgba(58, 114, 184, 0.11)",

      "code-bg":     "#0d0d0c",
      "code-text":   "#e8e6e1",
      "overlay":     "rgba(28, 27, 25, 0.32)",
      "selection":   "rgba(201, 100, 66, 0.18)"
    },
    "dark": {
      "surface-0":    "#131311",
      "surface-1":    "#191917",
      "surface-2":    "#1f1f1c",
      "surface-3":    "#262622",
      "surface-sunken": "#0d0d0c",
      "surface-hover":  "#262622",
      "surface-active": "#32322d",

      "text-primary":   "#eceae4",
      "text-secondary": "#a9a69f",
      "text-tertiary":  "#7a776f",
      "text-disabled":  "#4a4942",
      "text-inverse":   "#1c1b19",
      "text-on-accent": "#ffffff",

      "border-subtle":  "rgba(255, 255, 255, 0.07)",
      "border-default": "rgba(255, 255, 255, 0.11)",
      "border-strong":  "rgba(255, 255, 255, 0.19)",
      "border-focus":   "rgba(217, 118, 79, 0.60)",

      "accent":         "#d9764f",
      "accent-hover":   "#e5895f",
      "accent-active":  "#c96442",
      "accent-subtle":  "rgba(217, 118, 79, 0.16)",
      "accent-ring":    "rgba(217, 118, 79, 0.45)",

      "success": "#5fbd8d",
      "warning": "#d9a34a",
      "danger":  "#e06a5f",
      "info":    "#6f9fd8",
      "success-subtle": "rgba(95, 189, 141, 0.14)",
      "warning-subtle": "rgba(217, 163, 74, 0.14)",
      "danger-subtle":  "rgba(224, 106, 95, 0.14)",
      "info-subtle":    "rgba(111, 159, 216, 0.14)",

      "code-bg":     "#0d0d0c",
      "code-text":   "#e8e6e1",
      "overlay":     "rgba(0, 0, 0, 0.55)",
      "selection":   "rgba(217, 118, 79, 0.24)"
    }
  },

  "radius": {
    "$note": "角色语义圆角。禁止全局单一半径，禁止随意取值。",
    "xs":        "2px",
    "sm":        "4px",
    "md":        "6px",
    "lg":        "8px",
    "panel":     "10px",
    "xl":        "12px",
    "2xl":       "16px",
    "bubble":    "18px",
    "composer":  "20px",
    "pill":      "999px",
    "roleMap": {
      "badge":      "xs",
      "kbd":        "sm",
      "button-xs":  "md",
      "button":     "lg",
      "input":      "lg",
      "menu-item":  "lg",
      "card":       "panel",
      "attachment": "panel",
      "code":       "xl",
      "dialog":     "2xl",
      "sheet":      "2xl",
      "bubble":     "bubble",
      "composer":   "composer",
      "segmented":  "pill",
      "avatar":     "pill"
    },
    "concentricRule": "R_outer = R_inner + padding（嵌套时必须满足，否则曲率打架）"
  },

  "space": {
    "$note": "4px 网格。键名即像素值，无歧义。规则：一切间距必须是 4 的倍数；2px 仅允许用于发丝级微调（如分段控件轨道内边距）。",
    "$rule": "value % 4 === 0 || value === 2",
    "0": "0",
    "2": "2px",
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "16": "16px",
    "20": "20px",
    "24": "24px",
    "28": "28px",
    "32": "32px",
    "36": "36px",
    "40": "40px",
    "44": "44px",
    "48": "48px",
    "56": "56px",
    "64": "64px",
    "twMapping": "Tailwind 原生 spacing 已是 4px 网格：p-1=4px, p-2=8px, p-3=12px, p-4=16px, p-5=20px, p-6=24px, p-8=32px, p-9=36px, p-10=40px, p-12=48px, p-16=64px"
  },

  "typography": {
    "$note": "固定字阶。每个角色绑定字号 / 行高 / 字重，禁止随手 font-size。",
    "family": {
      "sans": "ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans', 'Microsoft YaHei', sans-serif",
      "serif": "ui-serif, Georgia, 'Songti SC', 'Times New Roman', serif",
      "mono": "'SF Mono', ui-monospace, Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "scale": {
      "caption":  { "size": "11px", "lineHeight": "16px", "weight": 400, "use": "时间戳、元数据、快捷键徽章" },
      "footnote": { "size": "12px", "lineHeight": "16px", "weight": 400, "use": "辅助说明、文件大小、次级标签" },
      "body":     { "size": "14px", "lineHeight": "20px", "weight": 400, "use": "正文、列表、表单值" },
      "body-lg":  { "size": "15px", "lineHeight": "22px", "weight": 400, "use": "输入框、宽松阅读区" },
      "prose":    { "size": "16px", "lineHeight": "26px", "weight": 400, "use": "长文阅读、Markdown 渲染" },
      "heading":  { "size": "15px", "lineHeight": "20px", "weight": 600, "use": "卡片标题、弹窗标题、分组名" },
      "title":    { "size": "20px", "lineHeight": "28px", "weight": 600, "use": "页面标题、面板主标题" },
      "display":  { "size": "32px", "lineHeight": "40px", "weight": 400, "use": "首屏问候、空状态大标题（可用 serif）" }
    },
    "darkWeightCompensation": {
      "$note": "白字在黑底会产生光晕外扩，感知上粗 10–15%。深色模式应主动减薄字重。",
      "regular":  { "light": 400, "dark": 360 },
      "medium":   { "light": 500, "dark": 460 },
      "semibold": { "light": 600, "dark": 550 }
    },
    "rules": {
      "dynamicNumbers": "font-variant-numeric: tabular-nums",
      "headingWrap": "text-wrap: balance",
      "bodyWrap": "text-wrap: pretty",
      "longToken": "overflow-wrap: anywhere; word-break: normal; min-width: 0",
      "inlineIconAlign": "vertical-align: -0.125em",
      "mobileInputFloor": "font-size: max(16px, body)"
    }
  },

  "elevation": {
    "$note": "双层复合阴影：近距微遮蔽 + 远距漫反射。禁止单层死黑。",
    "sm": {
      "light": "0 1px 2px rgba(28,27,25,0.05), 0 2px 8px rgba(28,27,25,0.06)",
      "dark":  "0 1px 2px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.40)"
    },
    "md": {
      "light": "0 2px 4px rgba(28,27,25,0.05), 0 6px 16px rgba(28,27,25,0.08)",
      "dark":  "0 2px 4px rgba(0,0,0,0.50), 0 6px 16px rgba(0,0,0,0.45)"
    },
    "lg": {
      "light": "0 4px 8px rgba(28,27,25,0.06), 0 12px 28px -2px rgba(28,27,25,0.09)",
      "dark":  "0 4px 8px rgba(0,0,0,0.55), 0 16px 36px -2px rgba(0,0,0,0.45)"
    },
    "popover": {
      "light": "0 0 0 1px rgba(28,27,25,0.10), 0 8px 24px rgba(28,27,25,0.12), 0 2px 6px rgba(28,27,25,0.07)",
      "dark":  "inset 0 0 0 1px rgba(255,255,255,0.10), 0 8px 28px rgba(0,0,0,0.65), 0 2px 6px rgba(0,0,0,0.45)",
      "note": "深色模式改用内侧倒角高光，模拟边缘捕捉顶光，避免黑底白框的荧光感"
    },
    "focusRing": {
      "light": "inset 0 0 0 1px var(--surface-1), 0 0 0 1.5px var(--accent), 0 0 6px 1px var(--accent-ring)",
      "dark":  "inset 0 0 0 1px var(--surface-2), 0 0 0 1.5px var(--accent), 0 0 8px 1px var(--accent-ring)"
    }
  },

  "motion": {
    "$note": "动效 = 物理预设 + 时长刻度。禁止手写 linear / ease + 任意时长。",
    "duration": {
      "instant": "60ms",
      "fast":    "120ms",
      "base":    "200ms",
      "sheet":   "300ms",
      "slow":    "450ms",
      "hardMax": { "micro": "200ms", "panel": "300ms", "ambient": "450ms" }
    },
    "easing": {
      "out":       "cubic-bezier(0.165, 0.84, 0.44, 1)",
      "snap":      "cubic-bezier(0.32, 0.72, 0, 1)",
      "overshoot": "cubic-bezier(0.34, 1.3, 0.64, 1)"
    },
    "springs": {
      "snappy": {
        "stiffness": 600, "damping": 30, "mass": 0.6,
        "zeta": 0.79, "overshoot": "1.8%", "settle": "220ms",
        "use": "按钮点击、Tab / 分段切换、微交互"
      },
      "bouncy": {
        "stiffness": 400, "damping": 25, "mass": 0.8,
        "zeta": 0.61, "overshoot": "8.8%", "settle": "380ms",
        "use": "开关、徽章入场、成功反馈"
      },
      "gentle": {
        "stiffness": 220, "damping": 24, "mass": 1.0,
        "zeta": 0.81, "overshoot": "1.5%", "settle": "480ms",
        "use": "弹窗、折叠展开、气泡进入、分栏复位"
      },
      "heavySnap": {
        "stiffness": 1200, "damping": 80, "mass": 0.1,
        "zeta": 1.83, "overshoot": "0%", "settle": "140ms",
        "use": "拖拽落点、边缘吸附、抽屉关闭（必须零超调）"
      }
    },
    "reducedMotion": "必须响应 prefers-reduced-motion: reduce —— 保留状态变化，移除位移与缩放，时长压至 1ms 或改用透明度"
  },

  "component": {
    "$note": "组件契约：把 semantic 令牌绑定到具体组件角色。agent 生成组件时应查此表而非自行组合。",
    "button": {
      "sizes": {
        "xs": { "height": "24px", "paddingX": "8px",  "fontSize": "11px", "radius": "md" },
        "sm": { "height": "28px", "paddingX": "10px", "fontSize": "12px", "radius": "lg" },
        "md": { "height": "32px", "paddingX": "12px", "fontSize": "14px", "radius": "lg" },
        "lg": { "height": "40px", "paddingX": "16px", "fontSize": "15px", "radius": "xl" }
      },
      "variants": {
        "primary":   { "bg": "accent", "fg": "text-on-accent", "hover": "accent-hover", "active": "accent-active", "border": "none" },
        "secondary": { "bg": "surface-2", "fg": "text-primary", "hover": "surface-hover", "border": "border-default" },
        "ghost":     { "bg": "transparent", "fg": "text-secondary", "hover": "surface-hover", "border": "none" },
        "outline":   { "bg": "transparent", "fg": "text-primary", "hover": "surface-hover", "border": "border-strong" },
        "danger":    { "bg": "danger", "fg": "text-inverse", "hover": "danger", "border": "none" }
      },
      "pressFeedback": "scale(0.98) + 时长 120ms"
    },
    "input": {
      "height": "32px", "radius": "lg", "bg": "surface-3", "border": "border-default",
      "focus": "focusRing", "placeholder": "text-tertiary", "fontSize": "14px"
    },
    "card": {
      "radius": "panel", "bg": "surface-2", "border": "border-subtle", "shadow": "sm",
      "hover": { "translateY": "-1.5px", "shadow": "md", "border": "border-default" }
    },
    "dialog": {
      "radius": "2xl", "bg": "surface-2", "shadow": "popover", "maxWidth": "448px",
      "overlay": "overlay", "backdropBlur": "8px"
    },
    "composer": {
      "radius": "composer", "bg": "surface-3", "shadow": "0 4px 20px rgba(28,27,25,0.035), inset 0 0 0 1px border-default",
      "maxHeight": "384px", "minHeight": "88px"
    },
    "messageBubble": {
      "user": { "radius": "bubble", "bg": "accent-subtle", "fg": "text-primary", "paddingX": "16px", "paddingY": "10px", "align": "end" },
      "assistant": { "radius": "none", "bg": "transparent", "fg": "text-primary", "align": "start", "maxWidth": "720px" }
    },
    "codeBlock": {
      "radius": "xl", "bg": "code-bg", "fg": "code-text", "headerHeight": "36px", "fontSize": "12px", "lineHeight": "18px"
    },
    "segmentedControl": {
      "radius": "pill", "trackBg": "surface-active", "thumbBg": "surface-2", "padding": "2px", "height": "32px", "transition": "120ms snap"
    },
    "table": {
      "headerBg": "surface-0", "rowBorder": "border-subtle", "cellPaddingX": "16px", "cellPaddingY": "12px",
      "numericAlign": "right", "numericFont": "tabular-nums"
    },
    "emptyState": {
      "iconSize": "24px", "titleScale": "title", "descScale": "body", "mustIncludeAction": true
    }
  },

  "breakpoints": {
    "$note": "优先使用容器查询。以下视口断点仅用于页面级骨架（shell），不用于组件内部。",
    "container": { "compact": "320px", "narrow": "384px", "medium": "480px", "wide": "576px", "full": "821px" },
    "viewport":  { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
    "rule": "组件内部禁止 @media (min-width)；必须用 @container"
  },

  "accessibility": {
    "contrast": { "bodyText": "4.5:1", "largeText": "3:1", "uiComponent": "3:1" },
    "touchTarget": "44px × 44px（视觉可小于此值，用负 margin 扩大命中区）",
    "focusVisible": "必须自定义 focus ring，禁止 outline: none 后不补焦点样式",
    "keyboard": "全部功能键盘可达；复合控件使用 roving tabindex",
    "aria": "图标按钮必须有 aria-label；模态必须有 role=dialog + aria-modal",
    "motion": "prefers-reduced-motion 必须被尊重"
  }
}
