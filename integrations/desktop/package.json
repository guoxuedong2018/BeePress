{
  "name": "@beepress/desktop",
  "private": true,
  "version": "0.3.2",
  "description": "Thin Bee Press desktop shell around an upstream DeepSeek Harness profile.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "install-profile": "node install-profile.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:mas": "electron-builder --mas"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "license": "MIT",
  "productName": "Bee Press",
  "build": {
    "appId": "com.beepress.desktop",
    "productName": "Bee Press",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "onboarding.html",
      "onboarding.css",
      "onboarding.js",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "extraResources": [
      {
        "from": "../../",
        "to": "beepress",
        "filter": [
          "bin/**/*",
          "pipeline/**/*",
          "scaffold/**/*",
          "docs/templates/**/*",
          "package.json"
        ]
      }
    ]
  }
}
