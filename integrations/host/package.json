{
  "name": "@builderharness/dsh-bundle",
  "version": "0.0.0-spike",
  "private": true,
  "type": "module",
  "description": "BuilderHarness host spike: DeepSeek Harness domain bundle plus MCP entrypoint.",
  "main": "src/dsh.mjs",
  "exports": {
    ".": "./src/dsh.mjs",
    "./client": "./lib/client.js",
    "./mcp": "./src/mcp.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "builderharness-mcp": "./src/mcp.mjs"
  },
  "files": [
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "builderharness": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "builderharness": {
      "optional": true
    }
  }
}
