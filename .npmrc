# vue / vite / less are peers: the host provides them. npm 7+ auto-installs
# peers by default, which can put a second copy of Vue here and split it from
# the host's instance — components render, but reactivity silently disagrees.
# That is extremely hard to debug, so disable peer auto-install for this repo.
legacy-peer-deps=true

# This repository is published from the public npm registry. Pin it here so a
# developer's global or proxy registry cannot silently change what is installed.
registry=https://registry.npmjs.org
