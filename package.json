{
  "name": "builder-kit",
  "version": "0.5.0",
  "description": "Bee Press — a hive of agents for prototype-native content production and publishing: source-anchored review, Agent-ready content studio, a DeepSeek Harness host plugin, an MCP bridge, reproducible media, and pluggable destinations.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "prototype",
    "review",
    "comments",
    "documentation",
    "vite",
    "vue",
    "react",
    "product-management",
    "content",
    "publishing",
    "agent",
    "agent-hive",
    "bee-press",
    "deepseek-harness",
    "dsh",
    "mcp",
    "screenshots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoxuedong2018/BeePress.git"
  },
  "homepage": "https://github.com/guoxuedong2018/BeePress#readme",
  "bugs": {
    "url": "https://github.com/guoxuedong2018/BeePress/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./client/index.js",
    "./vite": "./vite.mjs",
    "./core": "./client/core/mount.jsx",
    "./vue2": "./client/adapters/vue2.js",
    "./react": "./client/adapters/react.jsx",
    "./ui": "./ui-spec/impl/react/index.ts",
    "./tokens.css": "./ui-spec/tokens.css",
    "./tailwind.config.js": "./ui-spec/impl/react/tailwind.config.cjs",
    "./package.json": "./package.json",
    "./tailwind.config.cjs": "./ui-spec/impl/react/tailwind.config.cjs"
  },
  "bin": {
    "builder-kit": "./bin/builder-kit.mjs",
    "bk": "./bin/builder-kit.mjs",
    "beepress": "./bin/builder-kit.mjs"
  },
  "files": [
    "bin",
    "build",
    "client",
    "docs",
    "examples/react-tailwind/README.md",
    "examples/react-tailwind/index.html",
    "examples/react-tailwind/package.json",
    "examples/react-tailwind/postcss.config.cjs",
    "examples/react-tailwind/src",
    "examples/react-tailwind/tailwind.config.cjs",
    "examples/react-tailwind/vite.config.js",
    "examples/react-tailwind/docs/features",
    "examples/react-tailwind/docs/kb",
    "integrations",
    "pipeline",
    "server",
    "ui-spec",
    "vite.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/check-ui-spec.mjs && node scripts/check-public-deps.mjs && node integrations/test-integrations.mjs",
    "test:deploy-skill": "node scripts/test-deploy-skill-e2e.mjs",
    "test:publish-gateway": "node scripts/test-publish-gateway.mjs",
    "test:integrations": "node integrations/test-integrations.mjs",
    "demo": "node scripts/demo.mjs",
    "build:demo": "node scripts/demo.mjs build",
    "preflight": "node scripts/preflight-dist.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "less": ">=3",
    "tailwindcss": ">=4",
    "vite": ">=5",
    "vue": "^2.7.0"
  },
  "peerDependenciesMeta": {
    "less": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "less": "^4.9.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
